#!/usr/bin/expect -f
# Safe migration — adds new columns/tables WITHOUT dropping existing data
# Use when: adding columns, new tables, non-destructive schema changes
set timeout -1
set password "12345678"

# 1. Rsync the api files
spawn rsync -avz --delete --exclude vendor --exclude storage/*.sqlite --exclude "database/*.sqlite" --exclude .git -e "ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null" velnox-api/ user@mail.irbis.ua:/srv/projects/velnox/api/
expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    eof
}

# 2. SSH and migrate (NOT fresh — preserves existing data)
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null user@mail.irbis.ua
expect {
    "password:" {
        send "$password\r"
    }
}

expect "$ "
send "cd /srv/projects/velnox/api\r"
expect "$ "
send "php artisan migrate --force\r"
expect "$ "
send "echo \"12345678\" | sudo -S systemctl restart velnox-api\r"
expect "$ "
send "systemctl status velnox-api --no-pager\r"
expect "$ "
send "exit\r"
expect eof
